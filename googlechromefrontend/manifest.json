{
  "manifest_version": 3,
  "name": "Truthfulness and Phishing Detection Tool",
  "description": "Detects truthfulness of statements and phishing links using a hybrid LLM model.",
  "version": "1.0",
  "permissions": [
     "tabs",
    "activeTab",
     "storage",
     "scripting"
   ],
   "host_permissions": [
     "<all_urls>"
   ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  }
}

  